# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name where uploaded health / parent consent docs live.
SUPABASE_DOCS_BUCKET=battles3-docs

# ====== Google Sheets (Service Account) ======
# 1. Create a Google Cloud project, enable Sheets API.
# 2. Create a Service Account, generate a JSON key.
# 3. Share your target Google Sheet with the service-account email (Editor).
# 4. Paste the JSON values below (escape newlines in the private key as \n).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_TAB_NAME=Registrations

# ====== iCredit + ריווחית אונליין — payment + auto receipts ======
# iCredit is the card-acquiring gateway in the Rivhit family.
# When iCredit charges a card, ריווחית אונליין auto-issues the receipt
# (continuity with the existing receipt numbering).
#
# Find these in icredit.rivhit.co.il →
#   הגדרות → עריכת פרטי משתמש → הגדרות ריווחית → "מזהה API"
ICREDIT_GROUP_PRIVATE_TOKEN=
# Optional — Rivhit Online API token for direct document operations.
RIVHIT_API_TOKEN=
# For development / before keys exist:
PAYMENT_MODE=mock   # mock | live

# Required for /api/payment/charge — long random string, e.g. `openssl rand -hex 32`
ADMIN_API_KEY=

# ====== Notifications (optional) ======
ADMIN_EMAIL=
