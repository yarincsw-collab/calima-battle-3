# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name where uploaded health / parent consent docs live.
SUPABASE_DOCS_BUCKET=battles3-docs

# ====== Google Sheets (Service Account) ======
# 1. Create a Google Cloud project, enable Sheets API.
# 2. Create a Service Account, generate a JSON key.
# 3. Share your target Google Sheet with the service-account email (Editor).
# 4. Paste the JSON values below (escape newlines in the private key as \n).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_TAB_NAME=Registrations

# ====== Admin & payment flow ======
# Payment is NOT collected on the website. After approving an athlete,
# the admin sends them a payment link manually via WhatsApp/SMS using
# the existing iCredit dashboard. The /admin page protects access with
# this key.
# Generate one with:  openssl rand -hex 32
ADMIN_API_KEY=

# ====== Notifications (optional) ======
ADMIN_EMAIL=
